APP_NAME=Smart-CBT
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database PostgreSQL 16 smart-cbt-db
DB_CONNECTION=pgsql
DB_HOST=smart-cbt-db
DB_PORT=5432
DB_DATABASE=smart_cbt
DB_USERNAME=smart_cbt
DB_PASSWORD=smart_cbt_password

# Session, Cache, & Queue menggunakan Redis 7 smart-redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_COOKIE=smart_cbt_session
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=smart-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_PREFIX=smart_cbt_

FILESYSTEM_DISK=public

# CBT Ports
CBT_WEB_PORT=8001
CBT_DB_PORT=5432
CBT_REDIS_PORT=6380

# SMART+ Integration (Sinkronisasi nilai & absensi)
CBT_API_TOKEN=cbt_secret_token_almadinah_2026
SMART_PLUS_API_BASE_URL=http://smart-web/api/v1
SMART_PLUS_API_TOKEN=smart_secret_token_almadinah_2026

# Docker Volume Mapping di VPS
CBT_VOLUME_STORAGE=smart-cbt_smart-cbt-storage
CBT_VOLUME_CACHE=smart-cbt_smart-cbt-cache
CBT_VOLUME_PUBLIC=smart-cbt_smart-cbt-public
CBT_VOLUME_PGDATA=smart-cbt_smart-cbt-pgdata

# Docker Container Database Credentials
DOCKER_CBT_DB_DATABASE=smart_cbt
DOCKER_CBT_DB_USERNAME=smart_cbt
DOCKER_CBT_DB_PASSWORD=smart_cbt_password
