<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Aktifkan entitlement berikut setelah mendapatkan persetujuan Apple Education
      (com.apple.developer.automatic-assessment-configuration) di Apple Developer Portal
      untuk mengaktifkan Single-App Assessment Lockdown penuh di iOS/iPadOS:
      <key>com.apple.developer.automatic-assessment-configuration</key>
      <true/>
    -->
</dict>
</plist>
