// ==============================================================================
// Konfigurasi White-Label SMART-CBT Exambro (iOS)
// Ubah nilai di file ini untuk mengganti nama aplikasi, Bundle ID, domain,
// maupun hash PIN saat membangun IPA untuk sekolah lain.
// Catatan sintaks .xcconfig: gunakan https:/$()/ agar '//' tidak terbaca komentar.
// ==============================================================================

APP_DISPLAY_NAME = SMART-CBT
PRODUCT_BUNDLE_IDENTIFIER = id.sch.smpaickkmb.smartcbt

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

DEFAULT_BASE_URL = https:/$()/ujian.smpaickkmb.sch.id
ALLOWED_HOSTS = ujian.smpaickkmb.sch.id

// SHA-256 hex digest dari DEFAULT_EXIT_PIN (default: "123456")
// Cara generate baru di macOS/Linux: printf 'KODE_BARU' | shasum -a 256
DEFAULT_EXIT_PIN_HASH = 8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92

// SHA-256 hex digest dari ADMIN_PIN tersembunyi (default: "998877")
DEFAULT_ADMIN_PIN_HASH = c7e9988d0ac79f466bf33b7bc5a8e31ebad2fe1f6e17c78919f5717acce44230

ENABLE_RUNTIME_DOMAIN_SWITCH = YES
ALLOW_GALLERY_DURING_EXAM = YES
